# Skopiuj do deploy/.env na serwerze (chmod 600) i uzupełnij. Plik .env jest w .gitignore.
# Sekrety generuj np.: openssl rand -hex 32   (tylko [0-9a-f] — bez znaków, które trzeba escapować
# w connection stringu czy w SQL).

# Domena główna — frontend na https://DOMAIN, Keycloak na https://auth.DOMAIN.
# Oba rekordy DNS (A/AAAA) muszą wskazywać na VPS, zanim Caddy spróbuje pobrać certyfikaty.
DOMAIN=turniejo.pl
# Email do Let's Encrypt (powiadomienia o wygasających certyfikatach).
ACME_EMAIL=

# Postgres — superuser (tylko do administracji/backupów) + osobni userzy aplikacji i Keycloaka.
# Uwaga: hasła są ustawiane tylko przy PIERWSZYM starcie z pustym wolumenem (postgres/init.sh).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# Keycloak — bootstrap admin realmu master (konsola tylko przez tunel SSH, patrz README).
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
# Sekret klienta turniejo-backend-admin (service account backendu do Admin API).
# Wstawiany do realmu przy pierwszym imporcie i przekazywany do API.
KEYCLOAK_BACKEND_ADMIN_SECRET=

# Auth.js — szyfrowanie ciasteczka sesji (openssl rand -base64 32).
NEXTAUTH_SECRET=

# Umami (opcjonalne) — puste = skrypt statystyk się nie ładuje. Wpiekane przy buildzie frontendu.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
