# Keycloak (logowanie idzie bezpośrednio do Keycloaka — klient publiczny turniejo-frontend, PKCE)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=turniejo
KEYCLOAK_CLIENT_ID=turniejo-frontend

# Backend .NET (profil "http" z launchSettings.json)
API_URL=http://localhost:5264

# Auth.js — szyfrowanie ciasteczka sesji
# Wygeneruj: npx auth secret  (albo: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
