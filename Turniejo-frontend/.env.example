# Keycloak — logowanie z własnego formularza (grant_type=password) po stronie serwera Next.js
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=turniejo
KEYCLOAK_CLIENT_ID=turniejo-frontend
# Tylko dla klienta confidential — turniejo-frontend jest publiczny, więc zostaw puste.
KEYCLOAK_CLIENT_SECRET=

# Backend .NET (profil "http" z launchSettings.json)
API_URL=http://localhost:5264

# Auth.js — szyfrowanie ciasteczka sesji
# Wygeneruj: npx auth secret  (albo: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Umami — statystyki odwiedzin bez ciasteczek (brak banera zgody, patrz /privacy#cookies).
# Puste = skrypt się nie ładuje. Lokalnie: docker compose --profile analytics up -d w Turniejo-backend,
# panel http://localhost:3001 (admin/umami) → Settings → Websites → Add → skopiuj Website ID.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Publiczne demo: pasek „Wersja demo”, sekcja w regulaminie i notka przy rejestracji (true = włączone).
NEXT_PUBLIC_DEMO_MODE=
